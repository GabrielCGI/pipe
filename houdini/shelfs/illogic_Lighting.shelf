  <tool name="shotBuilder" label="Shot Builder" icon="hicon:/SVGIcons.index?LOP_lightfilterlibrary.svg">
    <script scriptType="python"><![CDATA[from imp import reload
import PrismInit

import lgt_shot_builder
reload(lgt_shot_builder)


core = PrismInit.pcore
entity = core.getScenefileData(core.getCurrentFileName())
data_shots = core.entities.getShotsFromSequence(entity["sequence"])
shots = []
for Dshot in data_shots:
    shots.append(Dshot["shot"])

print(dir(lgt_shot_builder))
lgt_shot_builder.shotBuilder(hou.selectedItems(), shots)]]></script>
