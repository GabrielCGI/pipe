  <tool name="illogic_lmfix_toggle0" label="LM Fix ON/OFF" icon="LOP_lightmixer">
    <helpText><![CDATA[Route les moves look-through vers le Light Mixer.
Clic = ON/OFF.]]></helpText>
    <script scriptType="python"><![CDATA[import importlib.util
import time
import traceback

import hou
import loputils
from pxr import Usd, UsdGeom

if hou.getenv('ILLOGIC_LMFIX') == '1':
    # ------------------------------------------------------------- OFF
    hou.putenv('ILLOGIC_LMFIX', '0')
    hou.ui.setStatusMessage(
        'LM Fix OFF - comportement stock (creation de edit_<light>)',
        hou.severityType.ImportantMessage)
else:
    # -------------------------------------------------------------- ON
    if getattr(hou.session, 'illogic_lmfix', None) is None:
        path = hou.findFile('scripts/scene/lop_cam_lock.py')
        spec = importlib.util.spec_from_file_location(
            'illogic_lmfix_override', path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        if not hasattr(mod, '_applyViewChangeToMixer'):
            raise hou.Error(
                "LM Fix : l'override lop_cam_lock.py n'est pas sur le "
                "HOUDINI_PATH (resolu : " + path + ")")

        orig = loputils.createEditorNode

        class _ShimParmTuple(object):
            def __init__(self, node, key):
                self._node = node
                self._key = key
            def set(self, values):
                self._node._store(self._key, values)
            def setPending(self, values):
                self._node._store(self._key, values)

        class _ShimNode(object):
            # Duck-type juste ce que le _applyViewChange stock utilise sur
            # le node editeur : input(0), parm(...), parmTuple('t'/'r').
            def __init__(self, mixer, primpath):
                self._mixer = mixer
                self._primpath = primpath
                self._vals = {}
            def input(self, idx):
                return self._mixer.input(0)
            def parm(self, name):
                return None
            def parmTuple(self, name):
                if name in ('t', 'r'):
                    return _ShimParmTuple(self, name)
                return None
            def _store(self, key, values):
                self._vals[key] = tuple(values)
                if 't' in self._vals and 'r' in self._vals:
                    vals = self._vals
                    self._vals = {}
                    self._fire(vals)
            def _fire(self, vals):
                try:
                    hou.putenv('ILLOGIC_LMFIX_BEACON',
                               'patch session (shim) @ '
                               + time.strftime('%H:%M:%S'))
                    local = hou.hmath.buildTransform(
                        {'translate': vals['t'], 'rotate': vals['r']})
                    inputnode = self._mixer.input(0)
                    prim = inputnode.stage().GetPrimAtPath(self._primpath)
                    in_local = hou.Matrix4(UsdGeom.Xformable(prim)
                        .GetLocalTransformation(Usd.TimeCode(hou.frame())))
                    world = local * in_local
                    mod._applyViewChangeToMixer(world, self._mixer,
                                                self._primpath,
                                                'Set Light to View')
                except Exception:
                    traceback.print_exc()

        def _patched(sourcenode, primpath, classancestor, primpaths,
                     respect_insertion_point=True, prefix='edit_', suffix='',
                     make_editor_node_current=False):
            # N'intercepte que si le flag est actif, pour l'appel du callback
            # lock-to-view (fingerprint), sur une light possedee par un
            # mixer, hors autokey.
            try:
                if hou.getenv('ILLOGIC_LMFIX') == '1':
                    camlock = (respect_insertion_point is False
                               and classancestor is None
                               and list(primpaths) == [primpath]
                               and prefix == 'edit_')
                    if camlock and not hou.ui.isAutoKey():
                        mixer = mod._findTargetMixer(sourcenode, primpath)
                        if mixer is not None:
                            return _ShimNode(mixer, primpath)
            except Exception:
                traceback.print_exc()
            return orig(sourcenode, primpath, classancestor, primpaths,
                        respect_insertion_point=respect_insertion_point,
                        prefix=prefix, suffix=suffix,
                        make_editor_node_current=make_editor_node_current)

        loputils.createEditorNode = _patched
        hou.session.illogic_lmfix = {'orig': orig}

    hou.putenv('ILLOGIC_LMFIX', '1')
    hou.ui.setStatusMessage(
        'LM Fix ON - les moves look-through vont dans le Light Mixer',
        hou.severityType.ImportantMessage)]]></script>
  </tool>

  <tool name="illogic_lmfix_toggle" label="LM Fix ON/OFF" icon="LOP_lightmixer">
    <helpText><![CDATA[Route les moves look-through vers le Light Mixer.
Clic = ON/OFF.]]></helpText>
    <script scriptType="python"><![CDATA[import importlib.util
import time
