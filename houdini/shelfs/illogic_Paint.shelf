  <tool name="copstartsample_toggle" label="Sample Canvas" icon="COP2_color">
    <helpText><![CDATA[Toggle: each PAINT stroke starts by sampling the canvas colour under its start point and painting the whole stroke with it. Patches the Cop/paint viewer state (all paint nodes).]]></helpText>
    <script scriptType="python"><![CDATA[import importlib
from paint_cop_recolor import recolor
importlib.reload(recolor)
recolor.sample_hotkey_install()   # 'I' over the viewport toggles result-mode
hou.ui.setStatusMessage("Sample-at-start: " + recolor.start_sample_toggle('canvas'))]]></script>
  </tool>

  <tool name="quick_null" label="quick_null" icon="PLASMA_App">
    <script scriptType="python"><![CDATA[import hou
import random
import colorsys


def random_node_color():
    """Generate a reasonably bright, saturated random color."""
    hue = random.random()
    saturation = random.uniform(0.45, 0.75)
    value = random.uniform(0.65, 0.90)

    rgb = colorsys.hsv_to_rgb(hue, saturation, value)
    return hou.Color(rgb)


def find_parm_by_label(node, labels):
    """Find a parameter using its displayed label."""
    labels = {label.lower() for label in labels}

    for parm in node.parms():
        label = parm.parmTemplate().label().lower()

        if label in labels:
            return parm

    return None


def choose_output(node):
    """
    Return the selected output index.

    If the node only has one output, return 0 without displaying a dialog.
    """
    output_names = node.outputNames()
    output_labels = node.outputLabels()

    output_count = max(
        len(output_names),
        len(output_labels),
    )

    if output_count == 0:
        raise hou.Error(
            "The selected node does not have any available outputs."
        )

    if output_count == 1:
        return 0

    choices = []

    for index in range(output_count):
        name = (
            output_names[index]
            if index < len(output_names)
            else ""
        )

        label = (
            output_labels[index]
            if index < len(output_labels)
            else ""
        )

        # Build a useful display name.
        if label and name and label != name:
            display_name = "{}  [{}]".format(label, name)
        elif label:
            display_name = label
        elif name:
            display_name = name
        else:
            display_name = "Output {}".format(index)

        choices.append(
            "{}: {}".format(index, display_name)
        )

    selection = hou.ui.selectFromList(
        choices,
        exclusive=True,
        message="Choose the output to connect from:\n{}".format(
            node.path()
        ),
        title="Choose COP Output",
        column_header="Available outputs",
        clear_on_cancel=True,
    )

    if not selection:
        raise hou.Error("Cancelled.")

    return selection[0]


# --------------------------------------------------------------------------
# Get selected source node
# --------------------------------------------------------------------------

selected_nodes = hou.selectedNodes()

if not selected_nodes:
    hou.ui.displayMessage(
        "Select a Copernicus node first.",
        severity=hou.severityType.Warning,
    )
    raise hou.Error("No node selected.")

source_node = selected_nodes[-1]
parent = source_node.parent()


# --------------------------------------------------------------------------
# Choose source output before creating anything
# --------------------------------------------------------------------------

selected_output_index = choose_output(source_node)


# --------------------------------------------------------------------------
# Ask for the new output name
# --------------------------------------------------------------------------

default_name = "out_" + source_node.name()

button, entered_name = hou.ui.readInput(
    "Enter the output name:",
    buttons=("Create", "Cancel"),
    default_choice=0,
    close_choice=1,
    title="Create COP Output",
    initial_contents=default_name,
)

if button != 0:
    raise hou.Error("Cancelled.")

entered_name = entered_name.strip()

if not entered_name:
    hou.ui.displayMessage(
        "The output name cannot be empty.",
        severity=hou.severityType.Warning,
    )
    raise hou.Error("Empty output name.")


# Avoid adding prefixes twice.
base_name = entered_name

if base_name.lower().startswith("out_"):
    base_name = base_name[4:]

if base_name.lower().startswith("fetch_"):
    base_name = base_name[6:]

null_name = "OUT_" + base_name
fetch_name = "fetch_" + base_name

color = random_node_color()


# --------------------------------------------------------------------------
# Create nodes
# --------------------------------------------------------------------------

with hou.undos.group("Create COP output and fetch"):

    # Create the Null.
    null_node = parent.createNode(
        "null",
        node_name=null_name,
        force_valid_node_name=True,
    )

    # Connect the specifically selected output.
    null_node.setInput(
        0,
        source_node,
        selected_output_index,
    )

    null_node.setColor(color)
    null_node.setPosition(
        source_node.position() + hou.Vector2(0, -2)
    )

    # Create the Fetch.
    fetch_node = parent.createNode(
        "fetch",
        node_name=fetch_name,
        force_valid_node_name=True,
    )

    fetch_node.setColor(color)
    fetch_node.setPosition(
        null_node.position() + hou.Vector2(3, 0)
    )

    # Set the Fetch COP Path.
    cop_path_parm = find_parm_by_label(
        fetch_node,
        (
            "COP Path",
            "COP",
        ),
    )

    if cop_path_parm is None:
        fetch_node.destroy()
        null_node.destroy()

        raise hou.Error(
            "Could not find the Fetch COP Path parameter."
        )

    cop_path_parm.set(null_node.path())

    # Select the Null before pressing the Fetch setup button.
    # The button may use the currently selected COP.
    null_node.setSelected(
        True,
        clear_all_selected=True,
    )

    # Configure the Fetch outputs from the target COP.
    setup_button = find_parm_by_label(
        fetch_node,
        (
            "Set Outputs from Selected COP",
            "Setup Outputs from Selected COP",
        ),
    )

    if setup_button is not None:
        setup_button.pressButton()

    null_node.setSelected(
        True,
        clear_all_selected=True,
    )
    null_node.setDisplayFlag(True)]]></script>
  </tool>

  <tool name="copbrushify_qol" label="QoL Setup" icon="MISC_preferences">
    <script scriptType="python"><![CDATA[import hou

CACHE_MB = 32607   # COP file cache limit, in MB

# --- 1) Tint Backfaces OFF (Display Options > Markers) on every viewport ---
sets = (hou.displaySetType.SceneObject, hou.displaySetType.SelectedObject,
        hou.displaySetType.GhostObject, hou.displaySetType.DisplayModel,
        hou.displaySetType.CurrentModel, hou.displaySetType.TemplateModel)
n = 0
for pane in hou.ui.paneTabs():
    if pane.type() == hou.paneTabType.SceneViewer:
        for vp in pane.viewports():
            for dst in sets:
                vp.settings().displaySet(dst).showPrimBackfaces(False)
            n += 1
print("[copBrushify QoL] tint backfaces OFF on %d viewport(s)." % n)

# --- 2) COP file cache size (Copernicus File COP RAM cache) ---
hou.hscript("copcache -F %d" % CACHE_MB)
print("[copBrushify QoL] " + hou.hscript("copcache -s")[0].strip().splitlines()[-1])
]]></script>
  </tool>

  <tool name="compo_background" label="Compo BG" icon="OBJ_camera">
    <helpText><![CDATA[Toggle the shot's latest Compo render as the camera background image.

Click once to turn it on: the shot is inferred from the current hip path, the tool walks up to the shot root and takes the highest version in Renders/2dRender/Compo that actually holds an image sequence, writes it as a $F pattern on the LOP-imported shot camera, and links every other camera in /obj (including the IPR camera) to it with a chs() expression.

Click again to turn the background off (Background Image Enable off on all cameras, paths kept).

Ctrl+click always turns it on and lets you choose the version by hand.]]></helpText>
    <script scriptType="python"><![CDATA[import os
import re

import hou


COMPO_SUBPATH = ("Renders", "2dRender", "Compo")

# Preferred first: decides which sequence wins inside a version folder.
IMAGE_EXTENSIONS = (".exr", ".png", ".tif", ".tiff", ".jpg", ".jpeg")

FRAME_PATTERN = re.compile(r"^(?P<stem>.+)\.(?P<frame>\d+)\.(?P<ext>[^.]+)$")
VERSION_PATTERN = re.compile(r"^v(?P<number>\d+)", re.IGNORECASE)
CLEAN_VERSION_PATTERN = re.compile(r"^v\d+$", re.IGNORECASE)


def find_compo_directory(hip_path):
    """Walk up from the hip file to the shot root and return its Compo folder."""
    directory = os.path.dirname(hip_path)

    while True:
        candidate = os.path.join(directory, *COMPO_SUBPATH)

        if os.path.isdir(candidate):
            return candidate.replace("\\", "/")

        parent = os.path.dirname(directory)

        if parent == directory:
            return None

        directory = parent


def collect_versions(compo_directory):
    """Return the version folders, newest first."""
    versions = []

    for name in sorted(os.listdir(compo_directory)):
        path = os.path.join(compo_directory, name)

        if not os.path.isdir(path):
            continue

        match = VERSION_PATTERN.match(name)

        if match is None:
            continue

        versions.append(
            (
                int(match.group("number")),
                CLEAN_VERSION_PATTERN.match(name) is not None,
                name,
                path.replace("\\", "/"),
            )
        )

    # Highest version first, and a bare "v049" beats a "v049 (mp4)" variant.
    versions.sort(key=lambda item: (item[0], item[1]), reverse=True)

    return versions


def find_sequence(directory):
    """Return (pattern, frame_count) for the best sequence in a folder."""
    groups = {}

    try:
        names = os.listdir(directory)
    except OSError:
        return None

    for name in names:
        match = FRAME_PATTERN.match(name)

        if match is None:
            continue

        extension = match.group("ext")

        if "." + extension.lower() not in IMAGE_EXTENSIONS:
            continue

        key = (
            match.group("stem"),
            len(match.group("frame")),
            extension,
        )

        groups[key] = groups.get(key, 0) + 1

    if not groups:
        return None

    def score(item):
        (_, _, extension), count = item
        rank = IMAGE_EXTENSIONS.index("." + extension.lower())

        return (-rank, count)

    (stem, padding, extension), count = max(groups.items(), key=score)

    return "{}.$F{}.{}".format(stem, padding, extension), count


def choose_version(versions):
    """Let the user pick a version folder instead of taking the latest."""
    selection = hou.ui.selectFromList(
        [item[2] for item in versions],
        default_choices=(0,),
        exclusive=True,
        message="Choose the Compo version:",
        title="Compo Background",
        column_header="Version",
        clear_on_cancel=True,
    )

    if not selection:
        raise hou.Error("Cancelled.")

    return versions[selection[0]]


def resolve_background(pick_by_hand):
    """Return (version_name, background_path, frame_count) for this shot."""
    hip_path = hou.hipFile.path().replace("\\", "/")

    if os.path.basename(hip_path).lower() == "untitled.hip":
        raise hou.Error(
            "Save the scene first, the Compo path is inferred from the hip path."
        )

    compo_directory = find_compo_directory(hip_path)

    if compo_directory is None:
        raise hou.Error(
            "No {} folder found above:\n{}".format(
                "/".join(COMPO_SUBPATH),
                hip_path,
            )
        )

    versions = collect_versions(compo_directory)

    if not versions:
        raise hou.Error("No version folder in:\n{}".format(compo_directory))

    candidates = [choose_version(versions)] if pick_by_hand else versions

    for _, _, version_name, version_path in candidates:
        sequence = find_sequence(version_path)

        if sequence is not None:
            pattern, frame_count = sequence

            return (
                version_name,
                "{}/{}".format(version_path, pattern),
                frame_count,
            )

    raise hou.Error("No image sequence found in:\n{}".format(compo_directory))


def collect_cameras():
    """Every camera object that exposes a background image parameter."""
    cameras = hou.node("/obj").recursiveGlob(
        "*",
        hou.nodeTypeFilter.ObjCamera,
    )

    return [
        camera
        for camera in cameras
        if camera.parm("vm_background") is not None
    ]


def choose_master(cameras):
    """The LOP-imported shot camera holds the real path, the rest link to it."""
    imported = [
        camera
        for camera in cameras
        if camera.type().name() == "lopimportcam"
    ]

    if imported:
        return imported[0]

    return cameras[0]


def background_reference(master, camera):
    """The chs() link written on the secondary cameras."""
    if camera.parent() == master.parent():
        target = "../{}/vm_background".format(master.name())
    else:
        target = "{}/vm_background".format(master.path())

    return '`chs("{}")`'.format(target)


def write(parm, value):
    """Write a parameter without following a channel reference.

    A camera already linked to the master holds a chs() reference, and a plain
    set() would follow it and write onto the master instead of the camera.
    """
    if parm is not None:
        parm.set(value, follow_parm_reference=False)


def is_enabled(master):
    """True when the background is currently active on the master camera."""
    enable = master.parm("vm_bgenable")

    if enable is None or not enable.eval():
        return False

    # An empty or self-referencing path counts as off, so a click repairs it.
    return bool(master.parm("vm_background").eval().strip())


def set_enabled(cameras, state):
    for camera in cameras:
        write(camera.parm("vm_bgenable"), state)


# --------------------------------------------------------------------------
# Toggle the background image on the shot cameras
# --------------------------------------------------------------------------

cameras = collect_cameras()

if not cameras:
    raise hou.Error("No camera with a background image parameter under /obj.")

master = choose_master(cameras)

# Ctrl+click always turns it on, with a manual version choice.
click_kwargs = globals().get("kwargs") or {}
pick_by_hand = bool(click_kwargs.get("ctrlclick"))


if not pick_by_hand and is_enabled(master):
    with hou.undos.group("Disable Compo background image"):
        set_enabled(cameras, 0)

    message = "[Compo BG] off ({} camera(s))".format(len(cameras))

    print(message)
    hou.ui.setStatusMessage(message)

else:
    version_name, background_path, frame_count = resolve_background(pick_by_hand)

    with hou.undos.group("Set Compo background image"):
        write(master.parm("vm_background"), background_path)

        for camera in cameras:
            if camera != master:
                write(
                    camera.parm("vm_background"),
                    background_reference(master, camera),
                )

        set_enabled(cameras, 1)

    message = "[Compo BG] on, {} ({} frames) on {}".format(
        version_name,
        frame_count,
        master.path(),
    )

    print(message)
    print("[Compo BG] " + background_path)

    for camera in cameras:
        if camera != master:
            print("[Compo BG] linked " + camera.path())

    hou.ui.setStatusMessage(message)
]]></script>
  </tool>

