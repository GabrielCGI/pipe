version 15.1 v5
Gizmo {
 inputs 3
 knobChanged "\n\nnode = nuke.thisNode()\nknob = nuke.thisKnob()\n\nif knob.name() == \"filter_autosize\" and knob.value() == 1:\n    node\['inherit_from'].setVisible(True)\n    node\['autosize_force'].setVisible(True)\nelif knob.name() == \"filter_autosize\" and knob.value() == 0:\n    node\['inherit_from'].setVisible(False)\n    node\['autosize_force'].setVisible(False)\n\nif knob.name() == \"ec_noise\" and knob.value() < 1:\n    node\[\"ec_noise\"].setValue(1)\nelif knob.name() == \"ec_noise\" and knob.value() > 6:\n    node\[\"ec_noise\"].setValue(6)\n\nelif knob.name() == \"ec_noise_variations\" and knob.value() < 0:\n    node\[\"ec_noise_variations\"].setValue(0)\nelif knob.name() == \"ec_noise_variations\" and knob.value() > 6:\n    node\[\"ec_noise_variations\"].setValue(6)\n"
 tile_color 0x530054ff
 note_font "Verdana Bold"
 addUserKnob {20 EC_TAB l EC}
 addUserKnob {26 title_display l "" +STARTLINE T "Display : "}
 addUserKnob {68 display l "" -STARTLINE M {Result "Noise Map" "EdgeCrush Only"}}
 addUserKnob {26 ""}
 addUserKnob {26 title_autosize l "" +STARTLINE T "AutoSize :"}
 addUserKnob {6 filter_autosize l "Filter AutoSize" -STARTLINE}
 addUserKnob {1 inherit_from l "Inherit From :" +HIDDEN}
 inherit_from FRED_StylisedChar
 addUserKnob {7 autosize_force l "AutoSize Mult" +HIDDEN}
 autosize_force 1
 addUserKnob {7 near +INVISIBLE}
 near {{"\[if \{\[exists parent.\[value inherit_from].PxF_DeepDefocus.znear]\} \{value parent.\[value inherit_from].PxF_DeepDefocus.znear\} else \{expr 0\}]"}}
 addUserKnob {7 far +INVISIBLE}
 far {{"\[if \{\[exists parent.\[value inherit_from].PxF_DeepDefocus.zfar]\} \{value parent.\[value inherit_from].PxF_DeepDefocus.zfar\} else \{expr 0\}]"}}
 addUserKnob {7 near_p l near% +INVISIBLE}
 near_p {{"\[if \{\[exists parent.\[value inherit_from].near_percentage]\} \{value parent.\[value inherit_from].near_percentage\} else \{expr 100\}]"}}
 addUserKnob {7 far_p l far% +INVISIBLE}
 far_p {{"\[if \{\[exists parent.\[value inherit_from].far_percentage]\} \{value parent.\[value inherit_from].far_percentage\} else \{expr 100\}]"}}
 addUserKnob {26 ""}
 addUserKnob {26 title_edgecrush l "" +STARTLINE T "Edgecrush :"}
 addUserKnob {3 ec_noise l "Noise Selection"}
 ec_noise 3
 addUserKnob {26 warning_noise01 l "" -STARTLINE T (1-6)}
 addUserKnob {3 ec_noise_variations l " | Noise Variations" -STARTLINE}
 ec_noise_variations 6
 addUserKnob {26 warning_noise02 l "" -STARTLINE T (0-6)}
 addUserKnob {7 ec_edgepush_out l "EdgePush \[OUT]" R 0 20}
 ec_edgepush_out 3
 addUserKnob {7 ec_edgepush_in l "EdgePush \[IN]" R 0 10}
 ec_edgepush_in 6
 addUserKnob {26 ""}
 addUserKnob {26 title_mask l "" +STARTLINE T "Mask :"}
 addUserKnob {6 mask_invert l invert -STARTLINE}
}
