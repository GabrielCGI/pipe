#! C:/Program Files/Nuke15.1v5/nuke-15.1.5.dll -nx
version 15.1 v5
add_layer {C_L_key C_L_key.red C_L_key.green C_L_key.blue C_L_key.alpha}
Gizmo {
 inputs 2
 knobChanged "\nnode = nuke.thisNode()\nknob = nuke.thisKnob()\n\nWATCHED_KNOBS = \{\n    \"saturation_before\",\n    \"colour\",\n    \"intensity\",\n    \"exposure\",\n    \"contrast\",\n    \"gamma\",\n    \"offset\",\n    \"saturation_after\",\n\}\n\n# Pas besoin de recalculer pour tous les autres knobs\nif knob.name() in WATCHED_KNOBS:\n\n    def different(knob_name, default, eps=1e-6):\n        k = node\[knob_name]\n\n        # Knob pilote par une expression ou une animation : modifie, sans l'evaluer.\n        # Au chargement d'un .nk le node cible peut ne pas encore exister : evaluer\n        # l'expression leve une erreur qui interrompt la lecture du script.\n        if k.hasExpression() or k.isAnimated():\n            return True\n\n        # Multi-value knobs: colour, contrast, gamma, offset...\n        if k.arraySize() > 1:\n            values = \[k.value(i) for i in range(k.arraySize())]\n\n            if isinstance(default, (tuple, list)):\n                defaults = default\n            else:\n                defaults = \[default] * len(values)\n\n            return any(\n                abs(value - default_value) > eps\n                for value, default_value in zip(values, defaults)\n            )\n\n        return abs(k.value() - default) > eps\n\n    modified = (\n        different(\"saturation_before\", 1.0)\n        or different(\"colour\", 1.0)\n        or different(\"intensity\", 1.0)\n        or different(\"exposure\", 0.0)\n        or different(\"contrast\", 1.0)\n        or different(\"gamma\", 1.0)\n        or different(\"offset\", 0.0)\n        or different(\"saturation_after\", 1.0)\n    )\n\n    if modified:\n        node\[\"tile_color\"].setValue(0x3A9E54FF)  # green\n    else:\n        node\[\"tile_color\"].setValue(0xFF7F00FF)  # original orange\n\n"
 tile_color 0xff7f00ff
 label "\[value lobe2]_\[value aov]"
 note_font "Verdana Bold"
 addUserKnob {20 settings l Settings:}
 addUserKnob {26 text l "" +STARTLINE T "1. Select the AOV to Grade:\n"}
 addUserKnob {68 lobe2 l "Lobe :" M {diffuse specular "" ""}}
 addUserKnob {41 aov l AOV: T AOV_Shuffle.in}
 addUserKnob {26 text_2 l "" +STARTLINE T " "}
 addUserKnob {6 premult_workflow l "Use Unpremult/Premult workflow?" t "When enabled, this will unpremult the incoming beauty and the chosen AOV before applying the grade. It will then premult it back to normal after grading." +STARTLINE}
 premult_workflow true
 addUserKnob {6 checkAov l "Check AOV" -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {26 text_1 l "" +STARTLINE T "2. Adjust the AOV:\n"}
 addUserKnob {7 saturation_before l "Saturation Before:" t "This is the saturation of the selected AOV before the colour adjustments are applied. Lowering this will give you a more \"true colour\" when grading." R 0 3}
 saturation_before 1
 addUserKnob {26 ""}
 addUserKnob {18 colour l Colour: t "Colour of the AOV"}
 colour {1 1 1}
 addUserKnob {6 colour_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {6 color_rgb_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 intensity l Intensity: t "Colour Intensity" R 0 10}
 intensity 1
 addUserKnob {7 exposure l Exposure: t "Exposure (In Stops)" R -5 5}
 addUserKnob {41 contrast l "Contrast :" T ColorCorrect1.contrast}
 addUserKnob {41 gamma l "Gamma :" T ColorCorrect1.gamma}
 addUserKnob {41 offset l "Offset :" T ColorCorrect1.offset}
 addUserKnob {26 ""}
 addUserKnob {7 saturation_after l "Saturation After:" t "This is the saturation of the selected AOV after the colour adjustments are applied." R 0 3}
 saturation_after 1
 addUserKnob {6 gamma_panelDropped l "panel dropped state" +HIDDEN +STARTLINE}
 addUserKnob {6 color_rgb_1_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 ""}
}
