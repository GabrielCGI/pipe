#! C:/Program Files/Nuke15.1v5/nuke-15.1.5.dll -nx
version 15.1 v5
Gizmo {
 tile_color 0x540054ff
 note_font "Verdana Bold"
 addUserKnob {20 HexTile}
 addUserKnob {41 "Local GPU: " T BlinkScript8.gpuName}
 addUserKnob {41 "Use GPU if Available" T BlinkScript8.useGPUIfAvailable}
 addUserKnob {26 ""}
 addUserKnob {6 checkPattern +STARTLINE}
 addUserKnob {7 upscale R 0.1 4}
