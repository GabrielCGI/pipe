  recompileCount 36
  ProgramGroup 1
  KernelDescription "3 \"df_KuwaharaAnisotropic\" iterate pixelWise 0543f7c07bfc86fea086c68aad7f6ea07042a220516f982fa91f62d7da9f8440 4 \"src\" Read Ranged2D \"structure_tensor\" Read Point \"radius_map\" Read Point \"dst\" Write Point 4 \"Size\" Float 1 AAAgQQ== \"Sharpness\" Float 1 AACAPw== \"Eccentricity\" Float 1 AAAAPw== \"Quality (0=full)\" Float 1 AAAAAA== 4 \"size\" 1 1 Default \"sharpness\" 1 1 Default \"eccentricity\" 1 1 Default \"quality\" 1 1 Default 7 \"srcrangeMin\" Int 2 1 AAAAAAAAAAA= \"srcrangeMax\" Int 2 1 AAAAAAAAAAA= \"max_offset\" Int 1 1 AAAAAA== \"ecc_adj\" Float 1 1 AAAAAA== \"norm_sharpness\" Float 1 1 AAAAAA== \"sector_env_cos\" Float 1 1 AAAAAA== \"sector_env_sin_sq\" Float 1 1 AAAAAA=="
  kernelSource "kernel df_KuwaharaAnisotropic : ImageComputationKernel<ePixelWise>\n\{\n\n/*\n *  Anisotropic Kuwahara — Blink C++ implementation by Derek Flood, 2024\n *  Adapted from the Blender GLSL script (Copyright: 2023 Blender Authors)\n *\n *  --- ILGC hardened revision -------------------------------------------\n *  Changes vs. the version currently in ILGC_Kuwahara.gizmo:\n *\n *  \[1] init() and process() now share ONE bound (`max_offset`, a `local`).\n *      Every src() read is clamped to it, so a read can never fall outside\n *      the region declared to setRange(). This is the structural fix for\n *      \"CUDA encountered a problem (700)\".\n *\n *  \[2] The zero-gradient fallback eigenvector was float2(1.0f) == (1,1),\n *      which is NOT unit length (|v| = 1.414). In flat regions (sky, mattes,\n *      solid backgrounds — i.e. constantly) that inflated the sampling window\n *      by up to sqrt(2) and pushed the reads right up against the declared\n *      range. Now float2(1.0f, 0.0f).\n *\n *  \[3] The declared range is derived from eccentricity instead of a blanket\n *      3*size. At Eccentricity 0.6 the tile drops from 125x125 to ~59x59\n *      (~4.5x less cached data per block).\n *\n *  \[4] `quality` now actually subsamples. The old formula\n *      stride = floor(radius/quality + 0.5) gave stride == 1 for the shipped\n *      preset (Size 20 / quality 16), i.e. the knob did nothing.\n *      `quality` is now the target sample count across the major axis.\n *\n *  \[5] NaN-safe early-outs (`!(x >= y)` instead of `x < y`) and hoisted\n *      trig / sharpness constants into init().\n * ---------------------------------------------------------------------- */\n\n    Image<eRead, eAccessRanged2D, eEdgeClamped> src;\n    Image<eRead, eAccessPoint,   eEdgeClamped> structure_tensor;\n    Image<eRead, eAccessPoint,   eEdgeClamped> radius_map;   // eEdgeClamped added: was returning 0 in the overscan border\n    Image<eWrite> dst;\n\n    param:\n        float size;\n        float sharpness;\n        float eccentricity;\n        float quality;      // 0 = exact (no subsampling); >0 = samples across the major axis\n\n    local:\n        int   max_offset;             // EXACTLY what init() passed to setRange()\n        float ecc_adj;                // (1 - clamped eccentricity) * 10\n        float norm_sharpness;         // sharpness * 10\n        float sector_env_cos;         // cos(sector envelope angle)\n        float sector_env_sin_sq;      // sin(sector envelope angle)^2\n\n    void define() \{\n        defineParam(size,         \"Size\",             10.0f);\n        defineParam(sharpness,    \"Sharpness\",         1.0f);\n        defineParam(eccentricity, \"Eccentricity\",      0.5f);\n        defineParam(quality,      \"Quality (0=full)\",  0.0f);\n    \}\n\n    inline float square(float x) \{\n        return x * x;\n    \}\n\n    void init() \{\n        const float MAX_ECCENTRICITY   = 0.95f;\n        const float ECCENTRICITY_SCALE = 10.0f;\n        const int   HARD_CAP           = 96;   // never declare a tile wider than 193px\n\n        float ecc = min(eccentricity, MAX_ECCENTRICITY);\n        ecc_adj   = (1.0f - ecc) * ECCENTRICITY_SCALE;\n\n        // Widest the ellipse can get: anisotropy is in \[0,1], so\n        //   W/radius <= (ecc_adj + 1) / ecc_adj   and   H/radius <= 1.\n        // The bbox of the rotated ellipse is at most sqrt(W^2 + H^2).\n        float max_w_factor = (ecc_adj + 1.0f) / ecc_adj;\n        float max_bound    = sqrt(square(max_w_factor) + 1.0f);\n\n        int r = int(ceil(max_bound * max(size, 0.0f))) + 2;\n        r = max(1, min(r, HARD_CAP));\n\n        max_offset = r;\n        src.setRange(-r, -r, r, r);\n\n        norm_sharpness = sharpness * 10.0f;\n\n        float envelope_angle = ((3.0f / 2.0f) * PI) / 8.0f;\n        sector_env_cos    = cos(envelope_angle);\n        sector_env_sin_sq = square(sin(envelope_angle));\n    \}\n\n    void process(int2 pos) \{\n        const float STDDEV_FLOOR = 0.02f;   // variance floor: avoids /0 and homogeneous-region artifacts\n        const float MIN_RADIUS   = 0.5f;    // below this the window is sub-pixel -> passthrough\n        const int   number_of_sectors = 8;\n\n        float radius_factor = clamp(radius_map().w, 0.0f, 1.0f);\n        float radius = radius_factor * size;\n\n        // NaN-safe: !(x >= y) is true for NaN, so bad input degrades to passthrough\n        if (!(radius >= MIN_RADIUS)) \{\n            dst() = src(0, 0);\n            return;\n        \}\n\n        // Structure tensor, column-major in a float4.\n        float4 encoded_structure_tensor = structure_tensor();\n        float dxdx = encoded_structure_tensor.x;\n        float dxdy = encoded_structure_tensor.y;\n        float dydy = encoded_structure_tensor.z;\n\n        float eigenvalue_first_term       = (dxdx + dydy) / 2.0f;\n        float eigenvalue_square_root_term = sqrt(square(dxdx - dydy) + 4.0f * square(dxdy)) / 2.0f;\n        float first_eigenvalue  = eigenvalue_first_term + eigenvalue_square_root_term;\n        float second_eigenvalue = eigenvalue_first_term - eigenvalue_square_root_term;\n\n        // \[2] Unit fallback. `> 0.0f` is false for NaN, so NaN also lands here.\n        float2 eigenvector = float2(first_eigenvalue - dxdx, -1.0f * dxdy);\n        float  eigenvector_length = length(eigenvector);\n        float2 unit_eigenvector = eigenvector_length > 0.0f\n                                ? eigenvector / eigenvector_length\n                                : float2(1.0f, 0.0f);\n\n        float eigenvalue_sum        = first_eigenvalue + second_eigenvalue;\n        float eigenvalue_difference = first_eigenvalue - second_eigenvalue;\n        float anisotropy = eigenvalue_sum > 0.0f ? eigenvalue_difference / eigenvalue_sum : 0.0f;\n\n        // Ellipse: wider for high anisotropy, circular for low. ecc_adj is hoisted to init().\n        float ellipse_width_factor = (ecc_adj + anisotropy) / ecc_adj;\n        float ellipse_width  = ellipse_width_factor * radius;\n        float ellipse_height = radius / ellipse_width_factor;\n\n        float cosine = unit_eigenvector.x;\n        float sine   = unit_eigenvector.y;\n\n        // Inverse transform: maps the ellipse onto a unit disk.\n        float2 inverse_ellipse_matrix_1( cosine / ellipse_width,  sine   / ellipse_width);\n        float2 inverse_ellipse_matrix_2(-sine   / ellipse_height, cosine / ellipse_height);\n\n        float2 ellipse_major_axis = ellipse_width * unit_eigenvector;\n        float2 ellipse_minor_axis = float2(ellipse_height * unit_eigenvector.y * -1.0f,\n                                           ellipse_height * unit_eigenvector.x);\n\n        int2 ellipse_bounds = int2(\n            ceil(sqrt(square(ellipse_major_axis.x) + square(ellipse_minor_axis.x))),\n            ceil(sqrt(square(ellipse_major_axis.y) + square(ellipse_minor_axis.y)))\n        );\n\n        // \[1] THE SAFETY NET. max_offset is literally the value handed to\n        // setRange(), so after this clamp no src(i,j) below can leave the tile,\n        // whatever the params, the input pixels, or float rounding do.\n        ellipse_bounds.x = max(0, min(ellipse_bounds.x, max_offset));\n        ellipse_bounds.y = max(0, min(ellipse_bounds.y, max_offset));\n\n        // 8-sector overlap polynomial parameters.\n        float sector_center_overlap_parameter = 2.0f / radius;\n        float cross_sector_overlap_parameter  =\n            (sector_center_overlap_parameter + sector_env_cos) / sector_env_sin_sq;\n\n        float4 weighted_mean_of_squared_color_of_sectors\[8];\n        float4 weighted_mean_of_color_of_sectors\[8];\n        float  sum_of_weights_of_sectors\[8];\n\n        // Centre pixel is handled outside the loop; its weight is 1/number_of_sectors.\n        float4 center_color         = src(0, 0);\n        float4 center_color_squared = center_color * center_color;\n        float  center_weight_b      = 1.0f / number_of_sectors;\n        float4 weighted_center_color         = center_color * center_weight_b;\n        float4 weighted_center_color_squared = center_color_squared * center_weight_b;\n\n        for (int i = 0; i < number_of_sectors; i++) \{\n            weighted_mean_of_squared_color_of_sectors\[i] = weighted_center_color_squared;\n            weighted_mean_of_color_of_sectors\[i]         = weighted_center_color;\n            sum_of_weights_of_sectors\[i]                 = center_weight_b;\n        \}\n\n        // \[4] Adaptive subsampling. `quality` = target samples across the major\n        // axis. stride 1 == exact. Each taken sample stands in for stride^2\n        // pixels, hence the sample_area weight below.\n        int stride = 1;\n        if (quality > 0.0f) \{\n            float span = 2.0f * float(max(ellipse_bounds.x, ellipse_bounds.y));\n            stride = max(1, int(ceil(span / quality)));\n        \}\n        float sample_area = float(stride * stride);\n\n        // Coefficients of |disk_point(i,j)|^2 = A*i^2 + B*i + C, constant across a row.\n        float row_a      = inverse_ellipse_matrix_1.x * inverse_ellipse_matrix_1.x +\n                           inverse_ellipse_matrix_2.x * inverse_ellipse_matrix_2.x;\n        float row_b_coef = 2.0f * (inverse_ellipse_matrix_1.x * inverse_ellipse_matrix_1.y +\n                                   inverse_ellipse_matrix_2.x * inverse_ellipse_matrix_2.y);\n        float row_c_coef = inverse_ellipse_matrix_1.y * inverse_ellipse_matrix_1.y +\n                           inverse_ellipse_matrix_2.y * inverse_ellipse_matrix_2.y;\n\n        // Only the upper two quadrants are visited; each sample is paired with its mirror.\n        for (int j = 0; j <= ellipse_bounds.y; j += stride) \{\n\n            float row_b    = row_b_coef * float(j);\n            float row_c    = row_c_coef * float(j) * float(j) - 1.0f;\n            float row_disc = row_b * row_b - 4.0f * row_a * row_c;\n\n            // NaN-safe: !(disc >= 0) catches NaN as well as negative\n            if (!(row_disc >= 0.0f) || row_a <= 0.0f) \{\n                continue;\n            \}\n            float row_sqrt = sqrt(row_disc);\n\n            int i_min = max(-ellipse_bounds.x, int(ceil ((-row_b - row_sqrt) / (2.0f * row_a))));\n            int i_max = min( ellipse_bounds.x, int(floor((-row_b + row_sqrt) / (2.0f * row_a))));\n\n            for (int i = i_min; i <= i_max; i += stride) \{\n\n                // Skip the mirrors already covered on row 0, and the centre pixel.\n                if (j == 0 && i <= 0) \{\n                    continue;\n                \}\n\n                float2 disk_point(\n                    inverse_ellipse_matrix_1.x * i + inverse_ellipse_matrix_1.y * j,\n                    inverse_ellipse_matrix_2.x * i + inverse_ellipse_matrix_2.y * j\n                );\n\n                float disk_point_length_squared = dot(disk_point, disk_point);\n                if (disk_point_length_squared > 1.0f) \{\n                    continue;\n                \}\n\n                float sector_weights\[8];\n\n                float2 polynomial = sector_center_overlap_parameter -\n                                    cross_sector_overlap_parameter * disk_point * disk_point;\n                sector_weights\[0] = square(max(0.0f,  disk_point.y + polynomial.x));\n                sector_weights\[2] = square(max(0.0f, -disk_point.x + polynomial.y));\n                sector_weights\[4] = square(max(0.0f, -disk_point.y + polynomial.x));\n                sector_weights\[6] = square(max(0.0f,  disk_point.x + polynomial.y));\n\n                float M_SQRT1_2 = 0.70710678118654752440f;\n                float2 rotated_disk_point = M_SQRT1_2 *\n                    float2(disk_point.x - disk_point.y, disk_point.x + disk_point.y);\n\n                float2 rotated_polynomial = sector_center_overlap_parameter -\n                    cross_sector_overlap_parameter * rotated_disk_point * rotated_disk_point;\n                sector_weights\[1] = square(max(0.0f,  rotated_disk_point.y + rotated_polynomial.x));\n                sector_weights\[3] = square(max(0.0f, -rotated_disk_point.x + rotated_polynomial.y));\n                sector_weights\[5] = square(max(0.0f, -rotated_disk_point.y + rotated_polynomial.x));\n                sector_weights\[7] = square(max(0.0f,  rotated_disk_point.x + rotated_polynomial.y));\n\n                float sector_weights_sum = sector_weights\[0] + sector_weights\[1] +\n                                           sector_weights\[2] + sector_weights\[3] +\n                                           sector_weights\[4] + sector_weights\[5] +\n                                           sector_weights\[6] + sector_weights\[7];\n                if (!(sector_weights_sum > 0.0f)) \{\n                    continue;   // no sector contribution -> skip (avoids 0/0 -> NaN)\n                \}\n                float radial_gaussian_weight =\n                    sample_area * exp(-PI * disk_point_length_squared) / sector_weights_sum;\n\n                float4 upper_color = src( i,  j);\n                float4 lower_color = src(-i, -j);\n                float4 upper_color_squared = upper_color * upper_color;\n                float4 lower_color_squared = lower_color * lower_color;\n\n                for (int k = 0; k < number_of_sectors; k++) \{\n                    float weight = sector_weights\[k] * radial_gaussian_weight;\n\n                    int upper_index = k;\n                    sum_of_weights_of_sectors\[upper_index]                 += weight;\n                    weighted_mean_of_color_of_sectors\[upper_index]         += upper_color * weight;\n                    weighted_mean_of_squared_color_of_sectors\[upper_index] += upper_color_squared * weight;\n\n                    int lower_index = (k + number_of_sectors / 2) % number_of_sectors;\n                    sum_of_weights_of_sectors\[lower_index]                 += weight;\n                    weighted_mean_of_color_of_sectors\[lower_index]         += lower_color * weight;\n                    weighted_mean_of_squared_color_of_sectors\[lower_index] += lower_color_squared * weight;\n                \}\n            \}\n        \}\n\n        // Sectors with lower standard deviation get more weight.\n        float  sum_of_weights = 0.0f;\n        float4 weighted_sum   = float4(0.0f);\n        for (int i = 0; i < number_of_sectors; i++) \{\n            weighted_mean_of_color_of_sectors\[i]         /= sum_of_weights_of_sectors\[i];\n            weighted_mean_of_squared_color_of_sectors\[i] /= sum_of_weights_of_sectors\[i];\n\n            float4 color_mean         = weighted_mean_of_color_of_sectors\[i];\n            float4 squared_color_mean = weighted_mean_of_squared_color_of_sectors\[i];\n            float4 color_variance     = fabs(squared_color_mean - color_mean * color_mean);\n\n            float standard_deviation = dot(\n                sqrt(float3(color_variance.x, color_variance.y, color_variance.z)), float3(1.0f));\n\n            float weight = 1.0f / pow(max(STDDEV_FLOOR, standard_deviation), norm_sharpness);\n\n            sum_of_weights += weight;\n            weighted_sum   += color_mean * weight;\n        \}\n\n        weighted_sum /= sum_of_weights;\n        dst(0) = weighted_sum.x;\n        dst(1) = weighted_sum.y;\n        dst(2) = weighted_sum.z;\n        dst(3) = weighted_sum.w;   // filtered source alpha, not the radius-map value\n    \}\n\};"
  rebuild ""
  df_KuwaharaAnisotropic_Size {{Size/iterations}}
  df_KuwaharaAnisotropic_Sharpness {{Sharpness}}
  df_KuwaharaAnisotropic_Eccentricity {{Eccentricity}}
  "df_KuwaharaAnisotropic_Quality (0=full)" {{parent.quality}}
  protectKernelWhenPublishing true
  rebuild_finalise ""
  name BlinkScript8
  xpos 77
  ypos 444
  disable {{"iterations < 2 ? 1:0"}}
 }
 BlinkScript {
  inputs 3
  kernelSourceFile R:/devBen/blinks/kuwahara/kuwahara_rm.cpp
  recompileCount 36
  ProgramGroup 1
  KernelDescription "3 \"df_KuwaharaAnisotropic\" iterate pixelWise 0543f7c07bfc86fea086c68aad7f6ea07042a220516f982fa91f62d7da9f8440 4 \"src\" Read Ranged2D \"structure_tensor\" Read Point \"radius_map\" Read Point \"dst\" Write Point 4 \"Size\" Float 1 AAAgQQ== \"Sharpness\" Float 1 AACAPw== \"Eccentricity\" Float 1 AAAAPw== \"Quality (0=full)\" Float 1 AAAAAA== 4 \"size\" 1 1 Default \"sharpness\" 1 1 Default \"eccentricity\" 1 1 Default \"quality\" 1 1 Default 7 \"srcrangeMin\" Int 2 1 AAAAAAAAAAA= \"srcrangeMax\" Int 2 1 AAAAAAAAAAA= \"max_offset\" Int 1 1 AAAAAA== \"ecc_adj\" Float 1 1 AAAAAA== \"norm_sharpness\" Float 1 1 AAAAAA== \"sector_env_cos\" Float 1 1 AAAAAA== \"sector_env_sin_sq\" Float 1 1 AAAAAA=="
  kernelSource "kernel df_KuwaharaAnisotropic : ImageComputationKernel<ePixelWise>\n\{\n\n/*\n *  Anisotropic Kuwahara — Blink C++ implementation by Derek Flood, 2024\n *  Adapted from the Blender GLSL script (Copyright: 2023 Blender Authors)\n *\n *  --- ILGC hardened revision -------------------------------------------\n *  Changes vs. the version currently in ILGC_Kuwahara.gizmo:\n *\n *  \[1] init() and process() now share ONE bound (`max_offset`, a `local`).\n *      Every src() read is clamped to it, so a read can never fall outside\n *      the region declared to setRange(). This is the structural fix for\n *      \"CUDA encountered a problem (700)\".\n *\n *  \[2] The zero-gradient fallback eigenvector was float2(1.0f) == (1,1),\n *      which is NOT unit length (|v| = 1.414). In flat regions (sky, mattes,\n *      solid backgrounds — i.e. constantly) that inflated the sampling window\n *      by up to sqrt(2) and pushed the reads right up against the declared\n *      range. Now float2(1.0f, 0.0f).\n *\n *  \[3] The declared range is derived from eccentricity instead of a blanket\n *      3*size. At Eccentricity 0.6 the tile drops from 125x125 to ~59x59\n *      (~4.5x less cached data per block).\n *\n *  \[4] `quality` now actually subsamples. The old formula\n *      stride = floor(radius/quality + 0.5) gave stride == 1 for the shipped\n *      preset (Size 20 / quality 16), i.e. the knob did nothing.\n *      `quality` is now the target sample count across the major axis.\n *\n *  \[5] NaN-safe early-outs (`!(x >= y)` instead of `x < y`) and hoisted\n *      trig / sharpness constants into init().\n * ---------------------------------------------------------------------- */\n\n    Image<eRead, eAccessRanged2D, eEdgeClamped> src;\n    Image<eRead, eAccessPoint,   eEdgeClamped> structure_tensor;\n    Image<eRead, eAccessPoint,   eEdgeClamped> radius_map;   // eEdgeClamped added: was returning 0 in the overscan border\n    Image<eWrite> dst;\n\n    param:\n        float size;\n        float sharpness;\n        float eccentricity;\n        float quality;      // 0 = exact (no subsampling); >0 = samples across the major axis\n\n    local:\n        int   max_offset;             // EXACTLY what init() passed to setRange()\n        float ecc_adj;                // (1 - clamped eccentricity) * 10\n        float norm_sharpness;         // sharpness * 10\n        float sector_env_cos;         // cos(sector envelope angle)\n        float sector_env_sin_sq;      // sin(sector envelope angle)^2\n\n    void define() \{\n        defineParam(size,         \"Size\",             10.0f);\n        defineParam(sharpness,    \"Sharpness\",         1.0f);\n        defineParam(eccentricity, \"Eccentricity\",      0.5f);\n        defineParam(quality,      \"Quality (0=full)\",  0.0f);\n    \}\n\n    inline float square(float x) \{\n        return x * x;\n    \}\n\n    void init() \{\n        const float MAX_ECCENTRICITY   = 0.95f;\n        const float ECCENTRICITY_SCALE = 10.0f;\n        const int   HARD_CAP           = 96;   // never declare a tile wider than 193px\n\n        float ecc = min(eccentricity, MAX_ECCENTRICITY);\n        ecc_adj   = (1.0f - ecc) * ECCENTRICITY_SCALE;\n\n        // Widest the ellipse can get: anisotropy is in \[0,1], so\n        //   W/radius <= (ecc_adj + 1) / ecc_adj   and   H/radius <= 1.\n        // The bbox of the rotated ellipse is at most sqrt(W^2 + H^2).\n        float max_w_factor = (ecc_adj + 1.0f) / ecc_adj;\n        float max_bound    = sqrt(square(max_w_factor) + 1.0f);\n\n        int r = int(ceil(max_bound * max(size, 0.0f))) + 2;\n        r = max(1, min(r, HARD_CAP));\n\n        max_offset = r;\n        src.setRange(-r, -r, r, r);\n\n        norm_sharpness = sharpness * 10.0f;\n\n        float envelope_angle = ((3.0f / 2.0f) * PI) / 8.0f;\n        sector_env_cos    = cos(envelope_angle);\n        sector_env_sin_sq = square(sin(envelope_angle));\n    \}\n\n    void process(int2 pos) \{\n        const float STDDEV_FLOOR = 0.02f;   // variance floor: avoids /0 and homogeneous-region artifacts\n        const float MIN_RADIUS   = 0.5f;    // below this the window is sub-pixel -> passthrough\n        const int   number_of_sectors = 8;\n\n        float radius_factor = clamp(radius_map().w, 0.0f, 1.0f);\n        float radius = radius_factor * size;\n\n        // NaN-safe: !(x >= y) is true for NaN, so bad input degrades to passthrough\n        if (!(radius >= MIN_RADIUS)) \{\n            dst() = src(0, 0);\n            return;\n        \}\n\n        // Structure tensor, column-major in a float4.\n        float4 encoded_structure_tensor = structure_tensor();\n        float dxdx = encoded_structure_tensor.x;\n        float dxdy = encoded_structure_tensor.y;\n        float dydy = encoded_structure_tensor.z;\n\n        float eigenvalue_first_term       = (dxdx + dydy) / 2.0f;\n        float eigenvalue_square_root_term = sqrt(square(dxdx - dydy) + 4.0f * square(dxdy)) / 2.0f;\n        float first_eigenvalue  = eigenvalue_first_term + eigenvalue_square_root_term;\n        float second_eigenvalue = eigenvalue_first_term - eigenvalue_square_root_term;\n\n        // \[2] Unit fallback. `> 0.0f` is false for NaN, so NaN also lands here.\n        float2 eigenvector = float2(first_eigenvalue - dxdx, -1.0f * dxdy);\n        float  eigenvector_length = length(eigenvector);\n        float2 unit_eigenvector = eigenvector_length > 0.0f\n                                ? eigenvector / eigenvector_length\n                                : float2(1.0f, 0.0f);\n\n        float eigenvalue_sum        = first_eigenvalue + second_eigenvalue;\n        float eigenvalue_difference = first_eigenvalue - second_eigenvalue;\n        float anisotropy = eigenvalue_sum > 0.0f ? eigenvalue_difference / eigenvalue_sum : 0.0f;\n\n        // Ellipse: wider for high anisotropy, circular for low. ecc_adj is hoisted to init().\n        float ellipse_width_factor = (ecc_adj + anisotropy) / ecc_adj;\n        float ellipse_width  = ellipse_width_factor * radius;\n        float ellipse_height = radius / ellipse_width_factor;\n\n        float cosine = unit_eigenvector.x;\n        float sine   = unit_eigenvector.y;\n\n        // Inverse transform: maps the ellipse onto a unit disk.\n        float2 inverse_ellipse_matrix_1( cosine / ellipse_width,  sine   / ellipse_width);\n        float2 inverse_ellipse_matrix_2(-sine   / ellipse_height, cosine / ellipse_height);\n\n        float2 ellipse_major_axis = ellipse_width * unit_eigenvector;\n        float2 ellipse_minor_axis = float2(ellipse_height * unit_eigenvector.y * -1.0f,\n                                           ellipse_height * unit_eigenvector.x);\n\n        int2 ellipse_bounds = int2(\n            ceil(sqrt(square(ellipse_major_axis.x) + square(ellipse_minor_axis.x))),\n            ceil(sqrt(square(ellipse_major_axis.y) + square(ellipse_minor_axis.y)))\n        );\n\n        // \[1] THE SAFETY NET. max_offset is literally the value handed to\n        // setRange(), so after this clamp no src(i,j) below can leave the tile,\n        // whatever the params, the input pixels, or float rounding do.\n        ellipse_bounds.x = max(0, min(ellipse_bounds.x, max_offset));\n        ellipse_bounds.y = max(0, min(ellipse_bounds.y, max_offset));\n\n        // 8-sector overlap polynomial parameters.\n        float sector_center_overlap_parameter = 2.0f / radius;\n        float cross_sector_overlap_parameter  =\n            (sector_center_overlap_parameter + sector_env_cos) / sector_env_sin_sq;\n\n        float4 weighted_mean_of_squared_color_of_sectors\[8];\n        float4 weighted_mean_of_color_of_sectors\[8];\n        float  sum_of_weights_of_sectors\[8];\n\n        // Centre pixel is handled outside the loop; its weight is 1/number_of_sectors.\n        float4 center_color         = src(0, 0);\n        float4 center_color_squared = center_color * center_color;\n        float  center_weight_b      = 1.0f / number_of_sectors;\n        float4 weighted_center_color         = center_color * center_weight_b;\n        float4 weighted_center_color_squared = center_color_squared * center_weight_b;\n\n        for (int i = 0; i < number_of_sectors; i++) \{\n            weighted_mean_of_squared_color_of_sectors\[i] = weighted_center_color_squared;\n            weighted_mean_of_color_of_sectors\[i]         = weighted_center_color;\n            sum_of_weights_of_sectors\[i]                 = center_weight_b;\n        \}\n\n        // \[4] Adaptive subsampling. `quality` = target samples across the major\n        // axis. stride 1 == exact. Each taken sample stands in for stride^2\n        // pixels, hence the sample_area weight below.\n        int stride = 1;\n        if (quality > 0.0f) \{\n            float span = 2.0f * float(max(ellipse_bounds.x, ellipse_bounds.y));\n            stride = max(1, int(ceil(span / quality)));\n        \}\n        float sample_area = float(stride * stride);\n\n        // Coefficients of |disk_point(i,j)|^2 = A*i^2 + B*i + C, constant across a row.\n        float row_a      = inverse_ellipse_matrix_1.x * inverse_ellipse_matrix_1.x +\n                           inverse_ellipse_matrix_2.x * inverse_ellipse_matrix_2.x;\n        float row_b_coef = 2.0f * (inverse_ellipse_matrix_1.x * inverse_ellipse_matrix_1.y +\n                                   inverse_ellipse_matrix_2.x * inverse_ellipse_matrix_2.y);\n        float row_c_coef = inverse_ellipse_matrix_1.y * inverse_ellipse_matrix_1.y +\n                           inverse_ellipse_matrix_2.y * inverse_ellipse_matrix_2.y;\n\n        // Only the upper two quadrants are visited; each sample is paired with its mirror.\n        for (int j = 0; j <= ellipse_bounds.y; j += stride) \{\n\n            float row_b    = row_b_coef * float(j);\n            float row_c    = row_c_coef * float(j) * float(j) - 1.0f;\n            float row_disc = row_b * row_b - 4.0f * row_a * row_c;\n\n            // NaN-safe: !(disc >= 0) catches NaN as well as negative\n            if (!(row_disc >= 0.0f) || row_a <= 0.0f) \{\n                continue;\n            \}\n            float row_sqrt = sqrt(row_disc);\n\n            int i_min = max(-ellipse_bounds.x, int(ceil ((-row_b - row_sqrt) / (2.0f * row_a))));\n            int i_max = min( ellipse_bounds.x, int(floor((-row_b + row_sqrt) / (2.0f * row_a))));\n\n            for (int i = i_min; i <= i_max; i += stride) \{\n\n                // Skip the mirrors already covered on row 0, and the centre pixel.\n                if (j == 0 && i <= 0) \{\n                    continue;\n                \}\n\n                float2 disk_point(\n                    inverse_ellipse_matrix_1.x * i + inverse_ellipse_matrix_1.y * j,\n                    inverse_ellipse_matrix_2.x * i + inverse_ellipse_matrix_2.y * j\n                );\n\n                float disk_point_length_squared = dot(disk_point, disk_point);\n                if (disk_point_length_squared > 1.0f) \{\n                    continue;\n                \}\n\n                float sector_weights\[8];\n\n                float2 polynomial = sector_center_overlap_parameter -\n                                    cross_sector_overlap_parameter * disk_point * disk_point;\n                sector_weights\[0] = square(max(0.0f,  disk_point.y + polynomial.x));\n                sector_weights\[2] = square(max(0.0f, -disk_point.x + polynomial.y));\n                sector_weights\[4] = square(max(0.0f, -disk_point.y + polynomial.x));\n                sector_weights\[6] = square(max(0.0f,  disk_point.x + polynomial.y));\n\n                float M_SQRT1_2 = 0.70710678118654752440f;\n                float2 rotated_disk_point = M_SQRT1_2 *\n                    float2(disk_point.x - disk_point.y, disk_point.x + disk_point.y);\n\n                float2 rotated_polynomial = sector_center_overlap_parameter -\n                    cross_sector_overlap_parameter * rotated_disk_point * rotated_disk_point;\n                sector_weights\[1] = square(max(0.0f,  rotated_disk_point.y + rotated_polynomial.x));\n                sector_weights\[3] = square(max(0.0f, -rotated_disk_point.x + rotated_polynomial.y));\n                sector_weights\[5] = square(max(0.0f, -rotated_disk_point.y + rotated_polynomial.x));\n                sector_weights\[7] = square(max(0.0f,  rotated_disk_point.x + rotated_polynomial.y));\n\n                float sector_weights_sum = sector_weights\[0] + sector_weights\[1] +\n                                           sector_weights\[2] + sector_weights\[3] +\n                                           sector_weights\[4] + sector_weights\[5] +\n                                           sector_weights\[6] + sector_weights\[7];\n                if (!(sector_weights_sum > 0.0f)) \{\n                    continue;   // no sector contribution -> skip (avoids 0/0 -> NaN)\n                \}\n                float radial_gaussian_weight =\n                    sample_area * exp(-PI * disk_point_length_squared) / sector_weights_sum;\n\n                float4 upper_color = src( i,  j);\n                float4 lower_color = src(-i, -j);\n                float4 upper_color_squared = upper_color * upper_color;\n                float4 lower_color_squared = lower_color * lower_color;\n\n                for (int k = 0; k < number_of_sectors; k++) \{\n                    float weight = sector_weights\[k] * radial_gaussian_weight;\n\n                    int upper_index = k;\n                    sum_of_weights_of_sectors\[upper_index]                 += weight;\n                    weighted_mean_of_color_of_sectors\[upper_index]         += upper_color * weight;\n                    weighted_mean_of_squared_color_of_sectors\[upper_index] += upper_color_squared * weight;\n\n                    int lower_index = (k + number_of_sectors / 2) % number_of_sectors;\n                    sum_of_weights_of_sectors\[lower_index]                 += weight;\n                    weighted_mean_of_color_of_sectors\[lower_index]         += lower_color * weight;\n                    weighted_mean_of_squared_color_of_sectors\[lower_index] += lower_color_squared * weight;\n                \}\n            \}\n        \}\n\n        // Sectors with lower standard deviation get more weight.\n        float  sum_of_weights = 0.0f;\n        float4 weighted_sum   = float4(0.0f);\n        for (int i = 0; i < number_of_sectors; i++) \{\n            weighted_mean_of_color_of_sectors\[i]         /= sum_of_weights_of_sectors\[i];\n            weighted_mean_of_squared_color_of_sectors\[i] /= sum_of_weights_of_sectors\[i];\n\n            float4 color_mean         = weighted_mean_of_color_of_sectors\[i];\n            float4 squared_color_mean = weighted_mean_of_squared_color_of_sectors\[i];\n            float4 color_variance     = fabs(squared_color_mean - color_mean * color_mean);\n\n            float standard_deviation = dot(\n                sqrt(float3(color_variance.x, color_variance.y, color_variance.z)), float3(1.0f));\n\n            float weight = 1.0f / pow(max(STDDEV_FLOOR, standard_deviation), norm_sharpness);\n\n            sum_of_weights += weight;\n            weighted_sum   += color_mean * weight;\n        \}\n\n        weighted_sum /= sum_of_weights;\n        dst(0) = weighted_sum.x;\n        dst(1) = weighted_sum.y;\n        dst(2) = weighted_sum.z;\n        dst(3) = weighted_sum.w;   // filtered source alpha, not the radius-map value\n    \}\n\};"
  rebuild ""
  df_KuwaharaAnisotropic_Size {{Size/iterations}}
  df_KuwaharaAnisotropic_Sharpness {{Sharpness}}
  df_KuwaharaAnisotropic_Eccentricity {{Eccentricity}}
  "df_KuwaharaAnisotropic_Quality (0=full)" {{parent.quality}}
  protectKernelWhenPublishing true
  rebuild_finalise ""
  name BlinkScript9
  xpos 77
  ypos 498
  disable {{"iterations < 3 ? 1:0"}}
 }
 BlinkScript {
  inputs 3
  kernelSourceFile R:/devBen/blinks/kuwahara/kuwahara_rm.cpp
  recompileCount 36
  ProgramGroup 1
  KernelDescription "3 \"df_KuwaharaAnisotropic\" iterate pixelWise 0543f7c07bfc86fea086c68aad7f6ea07042a220516f982fa91f62d7da9f8440 4 \"src\" Read Ranged2D \"structure_tensor\" Read Point \"radius_map\" Read Point \"dst\" Write Point 4 \"Size\" Float 1 AAAgQQ== \"Sharpness\" Float 1 AACAPw== \"Eccentricity\" Float 1 AAAAPw== \"Quality (0=full)\" Float 1 AAAAAA== 4 \"size\" 1 1 Default \"sharpness\" 1 1 Default \"eccentricity\" 1 1 Default \"quality\" 1 1 Default 7 \"srcrangeMin\" Int 2 1 AAAAAAAAAAA= \"srcrangeMax\" Int 2 1 AAAAAAAAAAA= \"max_offset\" Int 1 1 AAAAAA== \"ecc_adj\" Float 1 1 AAAAAA== \"norm_sharpness\" Float 1 1 AAAAAA== \"sector_env_cos\" Float 1 1 AAAAAA== \"sector_env_sin_sq\" Float 1 1 AAAAAA=="
  kernelSource "kernel df_KuwaharaAnisotropic : ImageComputationKernel<ePixelWise>\n\{\n\n/*\n *  Anisotropic Kuwahara — Blink C++ implementation by Derek Flood, 2024\n *  Adapted from the Blender GLSL script (Copyright: 2023 Blender Authors)\n *\n *  --- ILGC hardened revision -------------------------------------------\n *  Changes vs. the version currently in ILGC_Kuwahara.gizmo:\n *\n *  \[1] init() and process() now share ONE bound (`max_offset`, a `local`).\n *      Every src() read is clamped to it, so a read can never fall outside\n *      the region declared to setRange(). This is the structural fix for\n *      \"CUDA encountered a problem (700)\".\n *\n *  \[2] The zero-gradient fallback eigenvector was float2(1.0f) == (1,1),\n *      which is NOT unit length (|v| = 1.414). In flat regions (sky, mattes,\n *      solid backgrounds — i.e. constantly) that inflated the sampling window\n *      by up to sqrt(2) and pushed the reads right up against the declared\n *      range. Now float2(1.0f, 0.0f).\n *\n *  \[3] The declared range is derived from eccentricity instead of a blanket\n *      3*size. At Eccentricity 0.6 the tile drops from 125x125 to ~59x59\n *      (~4.5x less cached data per block).\n *\n *  \[4] `quality` now actually subsamples. The old formula\n *      stride = floor(radius/quality + 0.5) gave stride == 1 for the shipped\n *      preset (Size 20 / quality 16), i.e. the knob did nothing.\n *      `quality` is now the target sample count across the major axis.\n *\n *  \[5] NaN-safe early-outs (`!(x >= y)` instead of `x < y`) and hoisted\n *      trig / sharpness constants into init().\n * ---------------------------------------------------------------------- */\n\n    Image<eRead, eAccessRanged2D, eEdgeClamped> src;\n    Image<eRead, eAccessPoint,   eEdgeClamped> structure_tensor;\n    Image<eRead, eAccessPoint,   eEdgeClamped> radius_map;   // eEdgeClamped added: was returning 0 in the overscan border\n    Image<eWrite> dst;\n\n    param:\n        float size;\n        float sharpness;\n        float eccentricity;\n        float quality;      // 0 = exact (no subsampling); >0 = samples across the major axis\n\n    local:\n        int   max_offset;             // EXACTLY what init() passed to setRange()\n        float ecc_adj;                // (1 - clamped eccentricity) * 10\n        float norm_sharpness;         // sharpness * 10\n        float sector_env_cos;         // cos(sector envelope angle)\n        float sector_env_sin_sq;      // sin(sector envelope angle)^2\n\n    void define() \{\n        defineParam(size,         \"Size\",             10.0f);\n        defineParam(sharpness,    \"Sharpness\",         1.0f);\n        defineParam(eccentricity, \"Eccentricity\",      0.5f);\n        defineParam(quality,      \"Quality (0=full)\",  0.0f);\n    \}\n\n    inline float square(float x) \{\n        return x * x;\n    \}\n\n    void init() \{\n        const float MAX_ECCENTRICITY   = 0.95f;\n        const float ECCENTRICITY_SCALE = 10.0f;\n        const int   HARD_CAP           = 96;   // never declare a tile wider than 193px\n\n        float ecc = min(eccentricity, MAX_ECCENTRICITY);\n        ecc_adj   = (1.0f - ecc) * ECCENTRICITY_SCALE;\n\n        // Widest the ellipse can get: anisotropy is in \[0,1], so\n        //   W/radius <= (ecc_adj + 1) / ecc_adj   and   H/radius <= 1.\n        // The bbox of the rotated ellipse is at most sqrt(W^2 + H^2).\n        float max_w_factor = (ecc_adj + 1.0f) / ecc_adj;\n        float max_bound    = sqrt(square(max_w_factor) + 1.0f);\n\n        int r = int(ceil(max_bound * max(size, 0.0f))) + 2;\n        r = max(1, min(r, HARD_CAP));\n\n        max_offset = r;\n        src.setRange(-r, -r, r, r);\n\n        norm_sharpness = sharpness * 10.0f;\n\n        float envelope_angle = ((3.0f / 2.0f) * PI) / 8.0f;\n        sector_env_cos    = cos(envelope_angle);\n        sector_env_sin_sq = square(sin(envelope_angle));\n    \}\n\n    void process(int2 pos) \{\n        const float STDDEV_FLOOR = 0.02f;   // variance floor: avoids /0 and homogeneous-region artifacts\n        const float MIN_RADIUS   = 0.5f;    // below this the window is sub-pixel -> passthrough\n        const int   number_of_sectors = 8;\n\n        float radius_factor = clamp(radius_map().w, 0.0f, 1.0f);\n        float radius = radius_factor * size;\n\n        // NaN-safe: !(x >= y) is true for NaN, so bad input degrades to passthrough\n        if (!(radius >= MIN_RADIUS)) \{\n            dst() = src(0, 0);\n            return;\n        \}\n\n        // Structure tensor, column-major in a float4.\n        float4 encoded_structure_tensor = structure_tensor();\n        float dxdx = encoded_structure_tensor.x;\n        float dxdy = encoded_structure_tensor.y;\n        float dydy = encoded_structure_tensor.z;\n\n        float eigenvalue_first_term       = (dxdx + dydy) / 2.0f;\n        float eigenvalue_square_root_term = sqrt(square(dxdx - dydy) + 4.0f * square(dxdy)) / 2.0f;\n        float first_eigenvalue  = eigenvalue_first_term + eigenvalue_square_root_term;\n        float second_eigenvalue = eigenvalue_first_term - eigenvalue_square_root_term;\n\n        // \[2] Unit fallback. `> 0.0f` is false for NaN, so NaN also lands here.\n        float2 eigenvector = float2(first_eigenvalue - dxdx, -1.0f * dxdy);\n        float  eigenvector_length = length(eigenvector);\n        float2 unit_eigenvector = eigenvector_length > 0.0f\n                                ? eigenvector / eigenvector_length\n                                : float2(1.0f, 0.0f);\n\n        float eigenvalue_sum        = first_eigenvalue + second_eigenvalue;\n        float eigenvalue_difference = first_eigenvalue - second_eigenvalue;\n        float anisotropy = eigenvalue_sum > 0.0f ? eigenvalue_difference / eigenvalue_sum : 0.0f;\n\n        // Ellipse: wider for high anisotropy, circular for low. ecc_adj is hoisted to init().\n        float ellipse_width_factor = (ecc_adj + anisotropy) / ecc_adj;\n        float ellipse_width  = ellipse_width_factor * radius;\n        float ellipse_height = radius / ellipse_width_factor;\n\n        float cosine = unit_eigenvector.x;\n        float sine   = unit_eigenvector.y;\n\n        // Inverse transform: maps the ellipse onto a unit disk.\n        float2 inverse_ellipse_matrix_1( cosine / ellipse_width,  sine   / ellipse_width);\n        float2 inverse_ellipse_matrix_2(-sine   / ellipse_height, cosine / ellipse_height);\n\n        float2 ellipse_major_axis = ellipse_width * unit_eigenvector;\n        float2 ellipse_minor_axis = float2(ellipse_height * unit_eigenvector.y * -1.0f,\n                                           ellipse_height * unit_eigenvector.x);\n\n        int2 ellipse_bounds = int2(\n            ceil(sqrt(square(ellipse_major_axis.x) + square(ellipse_minor_axis.x))),\n            ceil(sqrt(square(ellipse_major_axis.y) + square(ellipse_minor_axis.y)))\n        );\n\n        // \[1] THE SAFETY NET. max_offset is literally the value handed to\n        // setRange(), so after this clamp no src(i,j) below can leave the tile,\n        // whatever the params, the input pixels, or float rounding do.\n        ellipse_bounds.x = max(0, min(ellipse_bounds.x, max_offset));\n        ellipse_bounds.y = max(0, min(ellipse_bounds.y, max_offset));\n\n        // 8-sector overlap polynomial parameters.\n        float sector_center_overlap_parameter = 2.0f / radius;\n        float cross_sector_overlap_parameter  =\n            (sector_center_overlap_parameter + sector_env_cos) / sector_env_sin_sq;\n\n        float4 weighted_mean_of_squared_color_of_sectors\[8];\n        float4 weighted_mean_of_color_of_sectors\[8];\n        float  sum_of_weights_of_sectors\[8];\n\n        // Centre pixel is handled outside the loop; its weight is 1/number_of_sectors.\n        float4 center_color         = src(0, 0);\n        float4 center_color_squared = center_color * center_color;\n        float  center_weight_b      = 1.0f / number_of_sectors;\n        float4 weighted_center_color         = center_color * center_weight_b;\n        float4 weighted_center_color_squared = center_color_squared * center_weight_b;\n\n        for (int i = 0; i < number_of_sectors; i++) \{\n            weighted_mean_of_squared_color_of_sectors\[i] = weighted_center_color_squared;\n            weighted_mean_of_color_of_sectors\[i]         = weighted_center_color;\n            sum_of_weights_of_sectors\[i]                 = center_weight_b;\n        \}\n\n        // \[4] Adaptive subsampling. `quality` = target samples across the major\n        // axis. stride 1 == exact. Each taken sample stands in for stride^2\n        // pixels, hence the sample_area weight below.\n        int stride = 1;\n        if (quality > 0.0f) \{\n            float span = 2.0f * float(max(ellipse_bounds.x, ellipse_bounds.y));\n            stride = max(1, int(ceil(span / quality)));\n        \}\n        float sample_area = float(stride * stride);\n\n        // Coefficients of |disk_point(i,j)|^2 = A*i^2 + B*i + C, constant across a row.\n        float row_a      = inverse_ellipse_matrix_1.x * inverse_ellipse_matrix_1.x +\n                           inverse_ellipse_matrix_2.x * inverse_ellipse_matrix_2.x;\n        float row_b_coef = 2.0f * (inverse_ellipse_matrix_1.x * inverse_ellipse_matrix_1.y +\n                                   inverse_ellipse_matrix_2.x * inverse_ellipse_matrix_2.y);\n        float row_c_coef = inverse_ellipse_matrix_1.y * inverse_ellipse_matrix_1.y +\n                           inverse_ellipse_matrix_2.y * inverse_ellipse_matrix_2.y;\n\n        // Only the upper two quadrants are visited; each sample is paired with its mirror.\n        for (int j = 0; j <= ellipse_bounds.y; j += stride) \{\n\n            float row_b    = row_b_coef * float(j);\n            float row_c    = row_c_coef * float(j) * float(j) - 1.0f;\n            float row_disc = row_b * row_b - 4.0f * row_a * row_c;\n\n            // NaN-safe: !(disc >= 0) catches NaN as well as negative\n            if (!(row_disc >= 0.0f) || row_a <= 0.0f) \{\n                continue;\n            \}\n            float row_sqrt = sqrt(row_disc);\n\n            int i_min = max(-ellipse_bounds.x, int(ceil ((-row_b - row_sqrt) / (2.0f * row_a))));\n            int i_max = min( ellipse_bounds.x, int(floor((-row_b + row_sqrt) / (2.0f * row_a))));\n\n            for (int i = i_min; i <= i_max; i += stride) \{\n\n                // Skip the mirrors already covered on row 0, and the centre pixel.\n                if (j == 0 && i <= 0) \{\n                    continue;\n                \}\n\n                float2 disk_point(\n                    inverse_ellipse_matrix_1.x * i + inverse_ellipse_matrix_1.y * j,\n                    inverse_ellipse_matrix_2.x * i + inverse_ellipse_matrix_2.y * j\n                );\n\n                float disk_point_length_squared = dot(disk_point, disk_point);\n                if (disk_point_length_squared > 1.0f) \{\n                    continue;\n                \}\n\n                float sector_weights\[8];\n\n                float2 polynomial = sector_center_overlap_parameter -\n                                    cross_sector_overlap_parameter * disk_point * disk_point;\n                sector_weights\[0] = square(max(0.0f,  disk_point.y + polynomial.x));\n                sector_weights\[2] = square(max(0.0f, -disk_point.x + polynomial.y));\n                sector_weights\[4] = square(max(0.0f, -disk_point.y + polynomial.x));\n                sector_weights\[6] = square(max(0.0f,  disk_point.x + polynomial.y));\n\n                float M_SQRT1_2 = 0.70710678118654752440f;\n                float2 rotated_disk_point = M_SQRT1_2 *\n                    float2(disk_point.x - disk_point.y, disk_point.x + disk_point.y);\n\n                float2 rotated_polynomial = sector_center_overlap_parameter -\n                    cross_sector_overlap_parameter * rotated_disk_point * rotated_disk_point;\n                sector_weights\[1] = square(max(0.0f,  rotated_disk_point.y + rotated_polynomial.x));\n                sector_weights\[3] = square(max(0.0f, -rotated_disk_point.x + rotated_polynomial.y));\n                sector_weights\[5] = square(max(0.0f, -rotated_disk_point.y + rotated_polynomial.x));\n                sector_weights\[7] = square(max(0.0f,  rotated_disk_point.x + rotated_polynomial.y));\n\n                float sector_weights_sum = sector_weights\[0] + sector_weights\[1] +\n                                           sector_weights\[2] + sector_weights\[3] +\n                                           sector_weights\[4] + sector_weights\[5] +\n                                           sector_weights\[6] + sector_weights\[7];\n                if (!(sector_weights_sum > 0.0f)) \{\n                    continue;   // no sector contribution -> skip (avoids 0/0 -> NaN)\n                \}\n                float radial_gaussian_weight =\n                    sample_area * exp(-PI * disk_point_length_squared) / sector_weights_sum;\n\n                float4 upper_color = src( i,  j);\n                float4 lower_color = src(-i, -j);\n                float4 upper_color_squared = upper_color * upper_color;\n                float4 lower_color_squared = lower_color * lower_color;\n\n                for (int k = 0; k < number_of_sectors; k++) \{\n                    float weight = sector_weights\[k] * radial_gaussian_weight;\n\n                    int upper_index = k;\n                    sum_of_weights_of_sectors\[upper_index]                 += weight;\n                    weighted_mean_of_color_of_sectors\[upper_index]         += upper_color * weight;\n                    weighted_mean_of_squared_color_of_sectors\[upper_index] += upper_color_squared * weight;\n\n                    int lower_index = (k + number_of_sectors / 2) % number_of_sectors;\n                    sum_of_weights_of_sectors\[lower_index]                 += weight;\n                    weighted_mean_of_color_of_sectors\[lower_index]         += lower_color * weight;\n                    weighted_mean_of_squared_color_of_sectors\[lower_index] += lower_color_squared * weight;\n                \}\n            \}\n        \}\n\n        // Sectors with lower standard deviation get more weight.\n        float  sum_of_weights = 0.0f;\n        float4 weighted_sum   = float4(0.0f);\n        for (int i = 0; i < number_of_sectors; i++) \{\n            weighted_mean_of_color_of_sectors\[i]         /= sum_of_weights_of_sectors\[i];\n            weighted_mean_of_squared_color_of_sectors\[i] /= sum_of_weights_of_sectors\[i];\n\n            float4 color_mean         = weighted_mean_of_color_of_sectors\[i];\n            float4 squared_color_mean = weighted_mean_of_squared_color_of_sectors\[i];\n            float4 color_variance     = fabs(squared_color_mean - color_mean * color_mean);\n\n            float standard_deviation = dot(\n                sqrt(float3(color_variance.x, color_variance.y, color_variance.z)), float3(1.0f));\n\n            float weight = 1.0f / pow(max(STDDEV_FLOOR, standard_deviation), norm_sharpness);\n\n            sum_of_weights += weight;\n            weighted_sum   += color_mean * weight;\n        \}\n\n        weighted_sum /= sum_of_weights;\n        dst(0) = weighted_sum.x;\n        dst(1) = weighted_sum.y;\n        dst(2) = weighted_sum.z;\n        dst(3) = weighted_sum.w;   // filtered source alpha, not the radius-map value\n    \}\n\};"
  rebuild ""
  df_KuwaharaAnisotropic_Size {{Size/iterations}}
  df_KuwaharaAnisotropic_Sharpness {{Sharpness}}
  df_KuwaharaAnisotropic_Eccentricity {{Eccentricity}}
  "df_KuwaharaAnisotropic_Quality (0=full)" {{parent.quality}}
  protectKernelWhenPublishing true
  rebuild_finalise ""
  name BlinkScript10
  xpos 77
  ypos 561
  disable {{"iterations < 4 ? 1:0"}}
 }
