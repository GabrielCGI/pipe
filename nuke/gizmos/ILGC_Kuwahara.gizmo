 knobChanged "\nn = nuke.thisNode()\nk = nuke.thisKnob()\n\nif k.name() == 'iterations' and k.value() < 1:\n    n\['iterations'].setValue(1)\nif k.name() == 'iterations' and k.value() > 6:\n    n\['iterations'].setValue(6)\n"
