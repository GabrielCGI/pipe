 addUserKnob {26 ""}
 addUserKnob {7 Size t "Radius of brush stroke" R 0 20}
 Size 20
 addUserKnob {7 Sharpness t "From (0) soft to (1) sharp brush stroke. "}
 Sharpness 1
 addUserKnob {7 Eccentricity t "Elongates brush strokes following the direction of image details. Ranges from isotropic (0) to anisotropic (1)."}
 Eccentricity 0.6
 addUserKnob {7 Blur l "Blur Structure Tensor" t "Gaussian smoothing of structure tensor to eliminate high frequency details." R 2 10}
 Blur 2
 addUserKnob {26 MapRadius l "Map Brush Size" +INVISIBLE T " "}
 addUserKnob {6 map l "Enable brush size mask (alpha)" t "A depth map can be shuffled into the alpha to control brush radius so that out of focus objects appear more abstract and stylized. \n\nThe size parameter acts as a multiplier for the mask." +INVISIBLE +STARTLINE}
 addUserKnob {6 normalize l "Normalize alpha mask" t "Mask is normalized into a 0 to 1 range and  clamped after the color corrections to avoid values above 1. " +INVISIBLE +STARTLINE}
 addUserKnob {26 label_1 l "Adjust alpha" +INVISIBLE T ""}
 addUserKnob {41 black l "Lift (Blackpoint)" +INVISIBLE T Grade1.black}
 addUserKnob {41 white l "Gain (Whitepoint)" +INVISIBLE T Grade1.white}
 addUserKnob {41 gamma +INVISIBLE T Grade1.gamma}
 addUserKnob {6 disable_1 l "disable color corrections" t "disables lift, gamma, gain." +INVISIBLE +STARTLINE}
 disable_1 true
 addUserKnob {20 Info}
 addUserKnob {26 Credit l "" +STARTLINE T "Adapted from the Blender GLSL script. An implementation of the Anisotropic Kuwahara\n filter described in the paper: Kyprianidis, Jan Eric, Henry Kang, and Jurgen Dollner. \n\"Image and video abstraction by anisotropic Kuwahara filtering.\" 2009.\n\nBlink C++ implementation by Derek Flood\nhttps://sharktacos.github.io "}
