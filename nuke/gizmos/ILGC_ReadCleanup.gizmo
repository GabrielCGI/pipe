 overscan {{"\[python nuke.toNode(\\\"CTRL_OVERSCAN\\\")\\\[\\\"overscan_ctrl\\\"\\].value(0)\\ if\\ nuke.toNode(\\\"CTRL_OVERSCAN\\\")\\ else\\ 0]"} {"\[python nuke.toNode(\\\"CTRL_OVERSCAN\\\")\\\[\\\"overscan_ctrl\\\"\\].value(1)\\ if\\ nuke.toNode(\\\"CTRL_OVERSCAN\\\")\\ else\\ 0]"}}
 addUserKnob {26 ""}
