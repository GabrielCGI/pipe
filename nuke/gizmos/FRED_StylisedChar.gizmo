 addUserKnob {26 title_KWH l "" +STARTLINE T "Kuwahara :"}
 addUserKnob {6 KWH_filter_edges l "Filter Edges ?" +STARTLINE}
 addUserKnob {7 filter_edges l "" -STARTLINE}
 filter_edges 0.2
 addUserKnob {7 KWH_radius_map_remap_white l "Radius Map Remap White"}
 KWH_radius_map_remap_white 0.3
 addUserKnob {7 KWH_radius_map_remap_black l "Radius Map Remap Black"}
 KWH_radius_map_remap_black 0.025
 addUserKnob {7 KWH_radius_map_noise_size l "Radius Map Noise Size" R 1 100}
 KWH_radius_map_noise_size 40
 addUserKnob {7 KWH_radius_map_noise_gain l "Radius Map Noise Gain"}
 KWH_radius_map_noise_gain 1
 addUserKnob {7 KWH_radius_map_preserve_tip_black l "Radius Map Preserve Tip Black"}
 KWH_radius_map_preserve_tip_black 0.65
 addUserKnob {7 radius_map_preserve_tip_white l "Radius Map Preserve Tip White"}
 radius_map_preserve_tip_white 0.75
 addUserKnob {7 radius_map_preserve_tip l "Radius Map Preserve Tip"}
 radius_map_preserve_tip 0.6
 addUserKnob {7 KWH_size l "KWH Size" R 0 30}
 KWH_size 15
 addUserKnob {7 kwh_eyebrows l "KWH Eyebrows Size" R 0 5}
 kwh_eyebrows 1
 addUserKnob {26 ""}
 addUserKnob {26 title_brushes l "" +STARTLINE T "Brushes :"}
 addUserKnob {68 brushes_mode l "Mode : " M {Interactive Baked}}
 brushes_mode Baked
 addUserKnob {7 brush_size l "Brush Size" +HIDDEN R 0 300}
 brush_size 36
 addUserKnob {7 brush_offset l "Brush Offset" +HIDDEN R 0 100}
 addUserKnob {7 brush_map1 l "Map 1 Gain"}
 addUserKnob {7 brush_map2 l "Map 2 Gain"}
 brush_map2 1
 addUserKnob {7 brush_median l "Brush Median" R 0 10}
 brush_median 2
 addUserKnob {7 brush_mask_projection_remap_white l "Mask Projection Remap White"}
 brush_mask_projection_remap_white 0.2
 addUserKnob {7 brush_mask_projection_remap_black l "Mask Projection Remap Black"}
 brush_mask_projection_remap_black 0.02
 addUserKnob {7 brush_distort l "Distort Force" R 0 10}
 brush_distort 4
 addUserKnob {26 ""}
 addUserKnob {26 title_mask l "" +STARTLINE T "Mask :"}
 addUserKnob {6 mask_invert l invert -STARTLINE}
 mask_invert true
 addUserKnob {6 mask_premult l premult -STARTLINE}
 addUserKnob {20 DEBUG_TAB l DEBUG}
 addUserKnob {7 debug_median_size l "Median on Pref (stabilize Pref) : Size " R 0 10}
 debug_median_size 1
 addUserKnob {41 shuffle l "" +STARTLINE T Shuffle16.shuffle}
}
