 addUserKnob {41 znear l "Near Value (cm)" T PxF_DeepDefocus.znear}
 addUserKnob {41 nearPick l near -STARTLINE T PxF_DeepDefocus.nearPick}
 addUserKnob {41 zfar l "Far Value (cm)" T PxF_DeepDefocus.zfar}
 addUserKnob {41 farPick l far -STARTLINE T PxF_DeepDefocus.farPick}
 addUserKnob {7 near_percentage l "Filter % (near)" R 0 100}
 near_percentage 100
 addUserKnob {7 far_percentage l "Filter % (far)" R 0 100}
 far_percentage 10
 addUserKnob {20 endGroup n -1}
