version 15.1 v5
Gizmo {
 inputs 3
 knobChanged "\n\nnode = nuke.thisNode()\nknob = nuke.thisKnob()\n\nif knob.name() == \"filter_autosize\" and knob.value() == 1:\n    node\['inherit_from'].setVisible(True)\n    node\['autosize_force'].setVisible(True)\nelif knob.name() == \"filter_autosize\" and knob.value() == 0:\n    node\['inherit_from'].setVisible(False)\n    node\['autosize_force'].setVisible(False)\n"
 tile_color 0x540054ff
 note_font "Verdana Bold"
 addUserKnob {20 BBD_TAB l BBD}
 addUserKnob {26 title01 l "" -STARTLINE T "Display :"}
 addUserKnob {68 display l "" -STARTLINE M {Result "Fireflys Presence" "Radius Map" "Color Map"}}
 addUserKnob {26 ""}
 addUserKnob {26 title_autosize l "" +STARTLINE T "AutoSize :"}
 addUserKnob {6 filter_autosize l "Filter AutoSize" -STARTLINE}
 addUserKnob {1 inherit_from l "Inherit From :" +HIDDEN}
 inherit_from FRED_StylisedChar
 addUserKnob {7 autosize_force l "AutoSize Mult" +HIDDEN}
 autosize_force 1
 addUserKnob {7 near +INVISIBLE}
 near {{"\[if \{\[exists parent.\[value inherit_from].PxF_DeepDefocus.znear]\} \{value parent.\[value inherit_from].PxF_DeepDefocus.znear\} else \{expr 0\}]"}}
 addUserKnob {7 far +INVISIBLE}
 far {{"\[if \{\[exists parent.\[value inherit_from].PxF_DeepDefocus.zfar]\} \{value parent.\[value inherit_from].PxF_DeepDefocus.zfar\} else \{expr 0\}]"}}
 addUserKnob {7 near_p l near% +INVISIBLE}
 near_p {{"\[if \{\[exists parent.\[value inherit_from].near_percentage]\} \{value parent.\[value inherit_from].near_percentage\} else \{expr 100\}]"}}
 addUserKnob {7 far_p l far% +INVISIBLE}
 far_p {{"\[if \{\[exists parent.\[value inherit_from].far_percentage]\} \{value parent.\[value inherit_from].far_percentage\} else \{expr 100\}]"}}
 addUserKnob {26 ""}
 addUserKnob {26 title09 l "" +STARTLINE T "Radius Map :"}
 addUserKnob {7 rm_black_perimeter l "Radius Map Perimeter Black"}
 addUserKnob {7 rm_white_perimeter l "Radius Map Perimeter White"}
 rm_white_perimeter 0.185
 addUserKnob {7 rm_black_albedo l "Radius Map Albedo Black"}
 rm_black_albedo 0.625
 addUserKnob {7 rm_white_albedo l "Radius Map Albedo White"}
 rm_white_albedo 1
 addUserKnob {26 ""}
 addUserKnob {20 fireflysGroup l Fireflys n 1}
 addUserKnob {26 title03 l "" +STARTLINE T "Firefly01 :"}
 addUserKnob {7 f01Presence l Presence R 0 10}
 f01Presence 10
 addUserKnob {18 f01Gain l Gain R 0 4}
 f01Gain 1.3
 addUserKnob {6 f01Gain_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 ""}
 addUserKnob {26 title04 l "" +STARTLINE T "Firefly02 :"}
 addUserKnob {7 f02Presence l Presence R 0 10}
 f02Presence 10
 addUserKnob {18 f02Gain l Gain R 0 4}
 f02Gain 1.15
 addUserKnob {6 f02Gain_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 ""}
 addUserKnob {26 title05 l "" +STARTLINE T "Firefly03 :"}
 addUserKnob {7 f03Presence l Presence R 0 10}
 f03Presence 10
 addUserKnob {18 f03Gain l Gain R 0 4}
 f03Gain 0.95
 addUserKnob {6 f03Gain_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 ""}
 addUserKnob {26 title06 l "" +STARTLINE T "Firefly04 :"}
 addUserKnob {7 f04Presence l Presence R 0 10}
 f04Presence 10
 addUserKnob {18 f04Gain l Gain R 0 4}
