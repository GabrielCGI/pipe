{ 
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": { 
        "standard": { 
            "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": { 
        "default": { 
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "level": "WARNING",
            "stream": "ext://sys.stdout"
        },
        "file": {
            "class": "logging.FileHandler",
            "formatter": "standard",
            "level": "DEBUG",
            "mode": "a"
        }
    },
    "loggers": { 
        "IllogicPlugin": {
            "handlers": ["default", "file"],
            "level": "INFO",
            "propagate": false
        }
    } 
}